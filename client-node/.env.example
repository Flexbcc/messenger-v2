# --- Клиентская нода: минимальный конфиг ---
# Подключение к общей сети (обязательно):
DISCOVERY_NODE_URL=https://discovery.example-network.org
HOME_NODE_PUBLIC_URL=https://my-node.example.com:8001
JWT_SECRET=change-me
CLUSTER_ID=default

# Идентификаторы (по желанию):
HOME_NODE_ID=home-client
STORAGE_NODE_ID=storage-client
RELAY_NODE_ID=relay-client
HOME_PORT=8001

# Enrollment / обновления:
ENROLLMENT_MODE=legacy
NODE_BUILD_HASH=dev-local
