# client-node — пример конфигурации
# Скопируйте в .env и заполните значения:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# ОБЯЗАТЕЛЬНО — без этого нода не запустится
# ---------------------------------------------------------------------------

# Адрес discovery-ноды оператора (выдаётся оператором сети)
DISCOVERY_NODE_URL=http://<OPERATOR_DISCOVERY_IP>:8003

# Публичный IP/домен вашего VPS — как вас видят снаружи (через nginx TLS)
HOME_NODE_PUBLIC_URL=https://<YOUR_VPS_IP>
MEDIA_NODE_PUBLIC_URL=https://<YOUR_VPS_IP>:8444
TURN_NODE_PUBLIC_URL=https://<YOUR_VPS_IP>:8446
GATEWAY_NODE_PUBLIC_URL=https://<YOUR_VPS_IP>:8447

# Секреты — сгенерировать случайные строки (минимум 32 символа)
JWT_SECRET=change-me-generate-random-32-chars
TURN_SHARED_SECRET=change-me-generate-random-32-chars

# ---------------------------------------------------------------------------
# Идентификаторы нод — уникальны для каждого клиента
# ---------------------------------------------------------------------------
CLUSTER_ID=client-1
HOME_NODE_ID=home-client-1
STORAGE_NODE_ID=storage-client-1
RELAY_NODE_ID=relay-client-1
MEDIA_NODE_ID=media-client-1
TURN_NODE_ID=turn-client-1
GATEWAY_NODE_ID=gateway-client-1

# ---------------------------------------------------------------------------
# Порты (менять если стандартные заняты)
# ---------------------------------------------------------------------------
HOME_PORT=8001
MEDIA_PORT=8004
TURN_PORT=8006
GATEWAY_PORT=8007

# ---------------------------------------------------------------------------
# Режим enrollment — уточнить у оператора
#   legacy  — регистрация в discovery сразу trusted (открытая сеть)
#   strict  — требуется одобрение оператора (закрытая сеть)
#   hybrid  — новые ноды pending, уже approved остаются trusted
# ---------------------------------------------------------------------------
ENROLLMENT_MODE=legacy

# ---------------------------------------------------------------------------
# TURN / coturn — для звонков
# IP вашего VPS (тот же что в HOME_NODE_PUBLIC_URL)
# ---------------------------------------------------------------------------
TURN_SERVER_HOST=<YOUR_VPS_IP>
TURN_SERVER_PORT=3478

# ---------------------------------------------------------------------------
# Опционально
# ---------------------------------------------------------------------------
# NODE_RESOURCE_POLICY=cluster   # cluster — только свои ноды; federated — любые
# OWNER_RESOURCE_PERCENT=100     # % ресурсов ноды для владельца
# GATEWAY_INVITE_SECRET=         # Секрет для одноразовых invite-ссылок
# INTERNAL_SECURITY_MODE=legacy  # legacy | signed (межнодовая auth)
