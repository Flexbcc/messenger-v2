{
  "meta": {
    "product": "OUO Messenger — Node",
    "schema_version": "1.0.0",
    "locale": "ru-RU",
    "audience": "оператор клиентской/проектной ноды",
    "source_of_truth_for": [
      "client-node",
      "услуги self-hosted ноды"
    ],
    "value_conventions": {
      "boolean": "true/false",
      "single_select": "одно значение из options",
      "multi_select": "массив значений из options",
      "text": "строка",
      "number": "число",
      "secret": "секрет, не отображать и не логировать",
      "read_only": "заполняется системой",
      "action": "операция",
      "list": "управляемый список объектов"
    },
    "scopes": {
      "node": "конфигурация ноды (постоянная)",
      "runtime": "состояние во время работы (read_only)"
    },
    "storages": {
      "node_env": "переменная окружения (.env / docker-compose)",
      "node_config": "конфиг-файл ноды",
      "local_encrypted": "секрет в защищённом хранилище",
      "node_state": "вычисляется/наблюдается во время работы",
      "none": "action, не хранится"
    },
    "status_field": "status: implemented = поддержано кодом; planned = заготовка, кодом ещё не читается/не реализовано (проверено аудитом)."
  },
  "sections": [
    {
      "id": "network",
      "title": "Сеть и подключение",
      "icon": "network",
      "settings": [
        {
          "id": "network.discovery_url",
          "title": "Адрес discovery сети",
          "type": "text",
          "required": true,
          "description": "URL discovery общей сети — регистрация и heartbeat (исходящие). Нода не парсит ответы discovery на предмет настроек/обновлений.",
          "data": {
            "json_type": "string"
          },
          "ui": {
            "control": "text_input",
            "danger": false,
            "requires_confirmation": false
          },
          "scope": "node",
          "storage": "node_env",
          "env": "DISCOVERY_NODE_URL",
          "status": "implemented"
        },
        {
          "id": "network.public_url",
          "title": "Публичный URL ноды",
          "type": "text",
          "required": true,
          "description": "Как ноду видно снаружи (для регистрации в discovery).",
          "data": {
            "json_type": "string"
          },
          "ui": {
            "control": "text_input",
            "danger": false,
            "requires_confirmation": false
          },
          "scope": "node",
          "storage": "node_env",
          "env": "HOME_NODE_PUBLIC_URL",
          "status": "implemented"
        },
        {
          "id": "network.home_node_id",
          "title": "ID home-ноды",
          "type": "text",
          "default": "home-client",
          "description": "Идентификатор home-ноды.",
          "data": {
            "json_type": "string"
          },
          "ui": {
            "control": "text_input",
            "danger": false,
            "requires_confirmation": false
          },
          "scope": "node",
          "storage": "node_env",
          "env": "HOME_NODE_ID",
          "status": "implemented"
        },
        {
          "id": "network.cluster_id",
          "title": "Кластер",
          "type": "text",
          "default": "default",
          "description": "Идентификатор кластера.",
          "data": {
            "json_type": "string"
          },
          "ui": {
            "control": "text_input",
            "danger": false,
            "requires_confirmation": false
          },
          "scope": "node",
          "storage": "node_env",
          "env": "CLUSTER_ID",
          "status": "implemented"
        },
        {
          "id": "network.jwt_secret",
          "title": "Секрет подписи сессий",
          "type": "secret",
          "description": "Ключ подписи клиентских JWT-сессий.",
          "data": {
            "json_type": "string"
          },
          "ui": {
            "control": "password",
            "danger": true,
            "requires_confirmation": false
          },
          "scope": "node",
          "storage": "local_encrypted",
          "env": "JWT_SECRET",
          "status": "implemented"
        },
        {
          "id": "network.home_port",
          "title": "Порт home-ноды",
          "type": "number",
          "default": 8001,
          "description": "Порт публикации home-ноды.",
          "data": {
            "json_type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "ui": {
            "control": "number_input",
            "danger": false,
            "requires_confirmation": false
          },
          "scope": "node",
          "storage": "node_env",
          "env": "HOME_PORT",
          "status": "implemented",
          "impl_note": "Используется только в docker-compose (port-mapping), кодом ноды не читается."
        },
        {
          "id": "network.registered_status",
          "title": "Статус регистрации",
          "type": "read_only",
          "description": "online / offline / pending — по heartbeat в discovery.",
          "data": {
            "json_type": "string"
          },
          "ui": {
            "control": "info_row",
            "danger": false,
            "requires_confirmation": false
          },
          "scope": "runtime",
          "storage": "node_state",
          "status": "planned",
          "impl_note": "Статус online/offline/pending вычисляется на discovery/admin по heartbeat; локально на ноде не экспонируется (/health не возвращает registered_status)."
        },
        {
          "id": "network.storage_node_id",
          "title": "ID storage-ноды",
          "type": "text",
          "default": "storage-client",
          "description": "Идентификатор storage-ноды (офлайн-буфер).",
          "data": {
            "json_type": "string"
          },
          "ui": {
            "control": "text_input",
            "danger": false,
            "requires_confirmation": false
          },
          "scope": "node",
          "storage": "node_env",
          "env": "STORAGE_NODE_ID",
          "status": "implemented"
        },
        {
          "id": "network.relay_node_id",
          "title": "ID relay-ноды",
          "type": "text",
          "default": "relay-client",
          "description": "Идентификатор relay-ноды (микрохаб).",
          "data": {
            "json_type": "string"
          },
          "ui": {
            "control": "text_input",
            "danger": false,
            "requires_confirmation": false
          },
          "scope": "node",
          "storage": "node_env",
          "env": "RELAY_NODE_ID",
          "status": "implemented"
        },
        {
          "id": "network.resource_policy",
          "title": "Политика ресурсов",
          "type": "single_select",
          "options": [
            "local",
            "cluster",
            "federated"
          ],
          "default": "federated",
          "description": "Как home-node выбирает relay/storage при федерации.",
          "data": {
            "json_type": "string",
            "enum": [
              "local",
              "cluster",
              "federated"
            ]
          },
          "ui": {
            "control": "select",
            "danger": false,
            "requires_confirmation": false
          },
          "scope": "node",
          "storage": "node_env",
          "env": "NODE_RESOURCE_POLICY",
          "status": "implemented"
        }
      ]
    },
    {
      "id": "assistance",
      "title": "Помощь сети",
      "icon": "hands",
      "settings": [
        {
          "id": "assistance.enabled",
          "title": "Помогать сети",
          "type": "boolean",
          "default": false,
          "description": "Добровольная помощь другим пользователям. По умолчанию выключено (Personal only).",
          "data": {
            "json_type": "boolean"
          },
          "ui": {
            "control": "switch",
            "danger": false,
            "requires_confirmation": true
          },
          "scope": "node",
          "storage": "node_config",
          "status": "planned",
          "impl_note": "Модель network-assistance; в коде ноды не реализовано."
        },
        {
          "id": "assistance.roles",
          "title": "Разрешённые роли",
          "type": "multi_select",
          "options": [
            "limited_assistance",
            "public_relay",
            "temporary_storage",
            "discovery_helper",
            "witness"
          ],
          "default": [],
          "description": "Какие функции помощи включены. Видно только при assistance.enabled.",
          "data": {
            "json_type": "array",
            "items_enum": [
              "limited_assistance",
              "public_relay",
              "temporary_storage",
              "discovery_helper",
              "witness"
            ]
          },
          "ui": {
            "control": "multi-select",
            "danger": false,
            "requires_confirmation": false
          },
          "scope": "node",
          "storage": "node_config",
          "status": "planned",
          "impl_note": "Модель network-assistance; в коде ноды не реализовано."
        }
      ]
    },
