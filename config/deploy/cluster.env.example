# Shared cluster settings — copy relevant lines to each server's .env
# (main + all workers). Values must match across the island.
#
#   cp config/deploy/cluster.env.example /tmp/cluster.env
#   # edit, then merge into .env on each machine:
#   grep -v '^#' /tmp/cluster.env >> /opt/messenger/project/.env
#
# Do NOT commit real .env files.

CLUSTER_ID=default
ENROLLMENT_MODE=hybrid
INTERNAL_SECURITY_MODE=legacy
FEDERATION_ENVELOPE_MODE=legacy
NODE_RESOURCE_POLICY=federated

# Generate once on MAIN, copy same value to every worker .env:
# JWT_SECRET=
# DISCOVERY_ADMIN_SECRET=

# MAIN only (194.67.92.147):
# DISCOVERY_NODE_URL=http://discovery-node:8003
# GATEWAY_NODE_PUBLIC_URL=http://194.67.92.147:8007
# GATEWAY_DISCOVERY_PUBLIC_URL=http://194.67.92.147:8003

# WORKER only (161.104.18.45):
# DISCOVERY_NODE_URL=http://194.67.92.147:8003
# HOME_NODE_PUBLIC_URL=http://161.104.18.45:8001
# MEDIA_NODE_PUBLIC_URL=http://161.104.18.45:8004
