# Copy to pwa.env and adjust. Used by scripts/ship-pwa.sh
# Do not commit pwa.env if it contains secrets.

# SSH target for the explicitly selected static PWA host.
MAIN_HOST=root@pwa.example.org
REMOTE_DIR=/root/messenger-pwa
PWA_PORT=7357

# Baked into Flutter web build (--dart-define)
HOME_NODE_URL=https://ouo.example.org/home
MEDIA_NODE_URL=https://ouo.example.org/media
DISCOVERY_NODE_URL=https://ouo.example.org/discovery
GATEWAY_NODE_URL=https://ouo.example.org/gateway

# After HTTPS + nginx reverse proxy, switch to same-origin URLs, e.g.:
# PUBLIC_PWA_URL=https://ouo.example.org
