##############################################################################
# msng-test — переопределение портов и секретов
#
# Нужно только если порт по умолчанию занят. Скопируйте и правьте:
#     cp .env.example .env
#
# Docker Compose подхватывает .env из этой папки автоматически.
##############################################################################

# ── Порты ───────────────────────────────────────────────────────────────────
# Дефолты подобраны так, чтобы не конфликтовать с типичным окружением.
# Известное исключение: 8021 на macOS занимает системный launchd,
# поэтому client-2-home по умолчанию слушает 8022.

# PORT_DISCOVERY=8103
# PORT_CORE_HOME=8001
# PORT_CORE_MEDIA=8004
# PORT_CORE_TURN=8006
# PORT_C1_HOME=8011
# PORT_C1_MEDIA=8014
# PORT_C2_HOME=8022
# PORT_C2_MEDIA=8024
# PORT_C3_HOME=8031
# PORT_C3_MEDIA=8034
# PORT_STORAGE_APP=8042
# PORT_WEB=3000
# PORT_ADMIN=9210
# PORT_GW_DISCOVERY=9443
# PORT_GW_HOME=9444

# Проверить, свободен ли порт:
#     sudo lsof -nP -iTCP:8022 -sTCP:LISTEN

# ── Секреты ─────────────────────────────────────────────────────────────────
# Для теста подойдут дефолты. Для чего-то серьёзнее — задайте свои:
#     openssl rand -hex 32

# JWT_SECRET=
# DISCOVERY_ADMIN_SECRET=
# PUSH_PROXY_SECRET=
# TURN_SHARED_SECRET=
