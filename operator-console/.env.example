##############################################################################
# operator-console — конфигурация пульта
#
# Скопируйте в .env и заполните:
#     cp .env.example .env
#
# .env содержит секрет панели — он в .gitignore и не должен попасть в git.
##############################################################################

# ── Секрет панели ───────────────────────────────────────────────────────────
# Второй фактор поверх сертификата. Пульт спросит его в браузере.
# Сгенерировать:  openssl rand -hex 32
ADMIN_PANEL_SECRET=

# ── Адреса mTLS-шлюзов ──────────────────────────────────────────────────────
# Шлюз discovery — реестр федерации, телеметрия всех нод, аудит.
# Порт 9443 на машине, где крутится discovery.
OPERATOR_DISCOVERY_URL=https://node.example.com:9443

# Шлюз своей home-ноды — детальная телеметрия. Порт 9444.
# Можно оставить пустым, если управляете только реестром.
OPERATOR_HOME_URL=https://node.example.com:9444

# ── Свои ноды ───────────────────────────────────────────────────────────────
# node_id через запятую. Для этих нод доступны операции, выходящие
# за рамки телеметрии и реестра — конфигурация, перезапуск.
#
# Чужие ноды сюда вносить не нужно: для них останутся телеметрия
# из heartbeat и операции реестра федерации (approve/suspend/trust),
# а внутренностями своей ноды управляет её владелец.
OPERATOR_OWNED_NODES=core

# ── Имена файлов сертификатов ───────────────────────────────────────────────
# Меняйте, только если положили файлы под другими именами.
OPERATOR_CERT_NAME=operator.crt
OPERATOR_KEY_NAME=operator.key

##############################################################################
# SSH-канал — обслуживание своих серверов
#
# Нужен для деплоя, перезапуска контейнеров и чтения логов.
# Можно не настраивать: без него останутся телеметрия федерации
# и операции реестра — они идут через mTLS.
#
# Работает только на своих машинах: чужая нода не даёт root-доступ
# и не должна. Её владелец обслуживает её сам.
##############################################################################

# Путь к приватному SSH-ключу НА ВАШЕЙ МАШИНЕ.
# Заведите отдельный ключ для пульта, а не основной ~/.ssh/id_rsa:
#     ssh-keygen -t ed25519 -f ~/.ssh/messenger_ops -C "operator console"
#     ssh-copy-id -i ~/.ssh/messenger_ops.pub root@ваш-сервер
OPERATOR_SSH_KEY_PATH=~/.ssh/messenger_ops

# Псевдоним=адрес, через запятую.
# Псевдонимы используются в инвентаре ниже.
OPERATOR_SSH_HOSTS=main=root@194.67.92.147,worker=root@161.104.18.45

# Инвентарь: <compose-сервис>:<псевдоним хоста>:<порт health или ->
# Порт «-» — внутренний сервис без своего health-эндпоинта.
OPERATOR_NODE_INVENTORY=discovery-node:main:8003,gateway-node:main:8007,home-node:worker:8001,storage-node:worker:-,media-node:worker:8004,relay-node:worker:-,turn-node:worker:8006

# Каталог установки на серверах
OPERATOR_INSTALL_DIR=/opt/messenger/project
