# Copy this file to .env and fill in the real LAN IPs for your lab.
# You do not need every variable below on every machine — only the
# service(s) you actually run on that machine (via `docker compose up
# <service>`) read their own variables; the rest are ignored.
#
# See scripts/setup-node.sh for a guided setup that writes this file for you.

# ---------------------------------------------------------------------------
# Shared: every non-discovery node needs to know where Discovery Node lives.
# Point this at the LAN IP of the machine running discovery-node.
# ---------------------------------------------------------------------------
DISCOVERY_NODE_URL=http://192.168.1.10:8003

# Groups nodes under the same operator/island (public pool, corp, self-hosted).
# All nodes in one deployment should share the same CLUSTER_ID.
CLUSTER_ID=default

# How home-node picks relay/storage from Discovery (home-node only):
#   federated — any online node in Discovery (public multi-operator network)
#   cluster   — only nodes with the same CLUSTER_ID (private/local island)
#   local     — STORAGE_NODE_URL env only; no relay fallback via Discovery
NODE_RESOURCE_POLICY=federated

# Control Plane enrollment (ADR-0009): legacy | strict | hybrid
# Must match discovery-node ENROLLMENT_MODE when using strict/hybrid.
ENROLLMENT_MODE=legacy

# Service-to-service federation auth (ADR-0011): legacy | signed
# legacy = open internal endpoints (dev default); signed = Ed25519 headers required
INTERNAL_SECURITY_MODE=legacy
# FEDERATION_ENVELOPE_MODE=legacy|signed — signed wrapper around envelope (Phase B)
# FEDERATION_ENVELOPE_MODE=legacy
# FEDERATION_AUDIT_DB_PATH=/data/federation_audit.db
# BUFFER_MAX_ENVELOPE_BYTES=262144
# BUFFER_MAX_ENTRIES_PER_RECIPIENT=500
# BUFFER_EVICTION_POLICY=reject   # reject (429) или fifo (удалить старейшее)
# PREKEY_CONSUMPTION_MODE=legacy|strict
# GET /users/{id}/prekey-bundle?v=1 — strict one-time prekey (Phase C2)
# MEDIA_ACCESS_SECRET=  # defaults to JWT_SECRET
# MEDIA_NODE_URL=http://192.168.1.23:8004
# NODE_SIGNING_KEY_PATH=/data/node_signing_key
# FEDERATION_NONCE_DB_PATH=/data/federation_nonces.db
# Written by node_registration.py on strict/hybrid enroll (inside container /data).
# NODE_TOKEN_PATH=/data/node_token
# ENROLLMENT_SECRET_PATH=/data/enrollment_secret

# ---------------------------------------------------------------------------
# discovery-node — run this on your "main" PC (the monitoring/bootstrap node).
# ---------------------------------------------------------------------------
DISCOVERY_PORT=8003
DISCOVERY_ADMIN_SECRET=

# Attestation (ADR-0010): off | report | enforce
ATTESTATION_MODE=off

# Автодеградация trust level (Фаза 3.1): ноды, долго не присылающие heartbeat,
# автоматически понижаются в уровне доверия.
# TRUST_DEGRADE_L2_AFTER_DAYS=7      # L2→L1 через N дней offline
# TRUST_DEGRADE_L1_AFTER_DAYS=14     # L1→L0 через N дней offline
# TRUST_DEGRADATION_CHECK_INTERVAL_SECONDS=3600  # проверка раз в час
# Ротация Discovery signing key (grace period — оба ключа действуют параллельно):
# KEY_ROTATION_GRACE_DAYS=3
# Ротация вручную: POST /admin/discovery/rotate-key (требует DISCOVERY_ADMIN_SECRET)
MTLS_MODE=off
NODE_BUILD_HASH=dev-local

# TLS между нодами (nginx reverse proxy, Деплой TLS):
# Включить: bash scripts/enable-tls.sh
# После включения обновить публичные URL нод на https:
# HOME_NODE_PUBLIC_URL=https://192.168.1.10:8101
# STORAGE_NODE_PUBLIC_URL=https://192.168.1.10:8102
# RELAY_NODE_PUBLIC_URL=https://192.168.1.10:8105
# При включённом TLS: MTLS_MODE=report (логировать) или enforce (блокировать)
# ALLOWED_BUILD_HASHES=abc123,def456
# ALLOWED_TLS_CERT_FINGERPRINTS=sha256:...
# RELEASE_SIGNING_PUBLIC_KEYS=home-1:<base64_verify_key>,relay-1:<base64_verify_key>
# RELEASE_SIGNING_SECRET=change-me  # legacy fallback
# RELEASE_SIGNING_PRIVATE_KEY=<base64_private_key>  # local signing only
# NODE_RELEASE_SIGNATURE=  # from scripts/sign-node-release.py --algorithm ed25519|hmac

# ---------------------------------------------------------------------------
# gateway-node — public client entry (catalog + routing bootstrap)
# ---------------------------------------------------------------------------
GATEWAY_NODE_ID=gateway-1
GATEWAY_NODE_PUBLIC_URL=http://192.168.1.10:8007
GATEWAY_PORT=8007
GATEWAY_DISCOVERY_PUBLIC_URL=http://192.168.1.10:8003

# mTLS: scripts/generate-mtls-certs.sh → config/mtls/fingerprints.env
# GATEWAY_TLS_ENABLED=true
# GATEWAY_TLS_PORT=8447
# GATEWAY_MTLS_MODE=required|optional|off
# ALLOWED_GATEWAY_CLIENT_FINGERPRINTS=

# One-time client join invites (QR). Same value in laptop.env for Operator Console.
# GATEWAY_INVITE_SECRET=
# ALLOWED_TLS_CERT_FINGERPRINTS=
# NODE_TLS_CERT_FINGERPRINT=

# ---------------------------------------------------------------------------
# home-node — run on one of the VMs. HOME_NODE_PUBLIC_URL must be reachable
# by every other node on the LAN, so use this machine's own LAN IP, not
# localhost.
# ---------------------------------------------------------------------------
HOME_NODE_ID=home-1
HOME_NODE_PUBLIC_URL=http://192.168.1.21:8001
HOME_PORT=8001
STORAGE_NODE_URL=http://192.168.1.22:8002
STORAGE_NODE_URLS=http://192.168.1.22:8002
STORAGE_REPLICATION_FACTOR=1
STORAGE_WRITE_QUORUM=1
JWT_SECRET=change-me-please
# Автоочистка устройств без активности (home-node):
# DEVICE_STALE_DAYS=90              # устройство считается мёртвым через N дней
# DEVICE_CLEANUP_INTERVAL_SECONDS=86400  # проверка раз в сутки

# ---------------------------------------------------------------------------
# storage-node
# ---------------------------------------------------------------------------
STORAGE_NODE_ID=storage-1
STORAGE_NODE_PUBLIC_URL=http://192.168.1.22:8002
STORAGE_PORT=8002

# ---------------------------------------------------------------------------
# media-node
# ---------------------------------------------------------------------------
MEDIA_NODE_ID=media-1
MEDIA_NODE_PUBLIC_URL=http://192.168.1.23:8004
MEDIA_PORT=8004

# ---------------------------------------------------------------------------
# Web Push (PWA). Generate one VAPID key pair once and keep the private key
# only on the server. Existing browser subscriptions depend on this pair.
# ---------------------------------------------------------------------------
PUSH_PROXY_SECRET=replace-with-a-long-random-secret
# `./scripts/setup-web-push.sh` creates this file and fills PUBLIC_KEY.
VAPID_PRIVATE_KEY=/data/vapid_private.pem
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# relay-node
# ---------------------------------------------------------------------------
RELAY_NODE_ID=relay-1
RELAY_NODE_PUBLIC_URL=http://192.168.1.24:8005
RELAY_PORT=8005
# Rate-limit транзитных сообщений (Фаза 3.2)
# RELAY_RATE_LIMIT=100          # макс. запросов от одного origin_node_id
# RELAY_RATE_WINDOW_SECONDS=60  # за это окно (секунды)

# ---------------------------------------------------------------------------
# turn-node (only needed once calls/WebRTC are wired up client-side)
# ---------------------------------------------------------------------------
TURN_NODE_ID=turn-1
TURN_NODE_PUBLIC_URL=http://192.168.1.24:8006
TURN_PORT=8006
TURN_SHARED_SECRET=change-me-please

# coturn — реальный TURN/STUN сервер для WebRTC (запускается рядом с turn-node)
# TURN_REALM=messenger.local          # realm в STUN credentials
# TURN_EXTERNAL_IP=1.2.3.4           # публичный IP сервера (обязательно в проде!)
#                                     # без него STUN вернёт приватный IP и NAT не пробьётся
# Порты котурна (открыть на файрволле):
#   UDP/TCP 3478  — STUN/TURN
#   UDP/TCP 5349  — TURN over TLS
#   UDP 49152-65535 — медиарелей

# ---------------------------------------------------------------------------
# Deploy (multi-server) — see scripts/init-main-server.sh / bootstrap-worker.sh
# ---------------------------------------------------------------------------
# On each machine after bootstrap, update with ONE command:
#   ./scripts/node-update.sh
#   # or: ./update
#
# Local profile (not in git): config/deploy/node.profile
# Example: config/deploy/node.profile.example

# ---------------------------------------------------------------------------
# admin — optional bootstrap UI (ADR-0006). Production: localhost only.
#   docker compose up -d admin
#   ssh -L 9201:127.0.0.1:9201 root@MAIN
# Not in NODE_SERVICES on production main — configure via terminal (.env).
# ---------------------------------------------------------------------------
ADMIN_PORT=9200
ADMIN_BIND=127.0.0.1
