# Copy to .env.secure (ignored by Git), replace every placeholder with an
# independently generated random value and run scripts/validate-secure-env.py.

ENROLLMENT_MODE=strict
INTERNAL_SECURITY_MODE=signed
FEDERATION_NODE_ID_MODE=enforce
FEDERATION_ENVELOPE_MODE=signed
FEDERATION_CAPABILITY_MODE=enforce

# Bind HTTP management/bootstrap to loopback until an overlay IP is selected.
DISCOVERY_BIND=127.0.0.1
HOME_BIND=127.0.0.1
MEDIA_BIND=127.0.0.1
TURN_BIND=127.0.0.1
GATEWAY_BIND=127.0.0.1
GATEWAY_TLS_BIND=127.0.0.1
PUSH_PROXY_BIND=127.0.0.1
ADMIN_BIND=127.0.0.1

DISCOVERY_ADMIN_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTES
JWT_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTES
MEDIA_ACCESS_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTES
TURN_SHARED_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTES
PUSH_PROXY_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTES
GATEWAY_INVITE_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTES
ADMIN_PANEL_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTES
MESH_NOTIFY_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTES

HOME_NODE_ID=home-a
STORAGE_NODE_ID=storage-a
MEDIA_NODE_ID=media-a
RELAY_NODE_ID=relay-a
TURN_NODE_ID=turn-a
GATEWAY_NODE_ID=gateway-a

# Baseline is one Storage. Increase only after independent Storage nodes are
# provisioned; write quorum must never exceed replication factor (max 5).
STORAGE_NODE_URLS=http://storage-node:8002
STORAGE_REPLICATION_FACTOR=1
STORAGE_WRITE_QUORUM=1

# Secure startup requires a provisioned public Authority State. Infrastructure
# node certificates live in each role's own /data volume; Home may remain L0.
CAPABILITY_AUTHORITY_STATE_PATH=/data/capability_authority.json
CAPABILITY_CERTIFICATE_MODE=enforce
TRUST_AUTHORITY_STATE_PATH=
TRUST_LEDGER_MODE=enforce
TRUST_DEGRADATION_MODE=observe
# Public credentials only; private offline recovery keys never enter a node.
RECOVERY_AUTHORITY_STATE_PATH=
# Comma-separated Discovery origins reachable only through the private overlay.
AUTHORITY_GOSSIP_ENABLED=true
AUTHORITY_GOSSIP_PEERS=
AUTHORITY_GOSSIP_INTERVAL_SECONDS=30
AUTHORITY_GOSSIP_TIMEOUT_SECONDS=5
NODE_ADVERTISEMENT_GOSSIP_ENABLED=true
NODE_ADVERTISEMENT_GOSSIP_PEERS=
NODE_ADVERTISEMENT_GOSSIP_INTERVAL_SECONDS=30
NODE_ADVERTISEMENT_GOSSIP_TIMEOUT_SECONDS=5
RENDEZVOUS_GOSSIP_ENABLED=true
RENDEZVOUS_GOSSIP_PEERS=
RENDEZVOUS_GOSSIP_INTERVAL_SECONDS=30
RENDEZVOUS_GOSSIP_TIMEOUT_SECONDS=5
TRUST_RECORD_GOSSIP_ENABLED=true
TRUST_RECORD_GOSSIP_PEERS=
TRUST_RECORD_GOSSIP_INTERVAL_SECONDS=30
TRUST_RECORD_GOSSIP_TIMEOUT_SECONDS=5
TRUST_PROPOSAL_MODE=report
TRUST_PROPOSAL_INTERVAL_SECONDS=30
CHALLENGE_ASSIGNMENT_GOSSIP_ENABLED=true
CHALLENGE_ASSIGNMENT_GOSSIP_PEERS=
CHALLENGE_ASSIGNMENT_GOSSIP_INTERVAL_SECONDS=30
CHALLENGE_ASSIGNMENT_GOSSIP_TIMEOUT_SECONDS=5
CHALLENGE_PROPOSAL_SCHEDULER_MODE=enforce
CHALLENGE_PROPOSAL_SCHEDULER_INTERVAL_SECONDS=30
NODE_CHALLENGE_OBSERVER_ENABLED=true
NODE_CHALLENGE_OBSERVER_INTERVAL_SECONDS=30
# Switch to enforce only after a quorum RandomnessCheckpoint has converged.
RANDOMNESS_CHECKPOINT_MODE=enforce
# Switch to enforce only after node credential chains and their gossip have converged.
OPERATIONAL_CREDENTIAL_STATE_MODE=enforce
# Switch to enforce only after signed revocations and credential chains converge on D1/D2/D3.
OPERATIONAL_CREDENTIAL_REVOCATION_MODE=enforce
NODE_OPERATIONAL_CREDENTIAL_CHAIN_PATH=
SIGNED_PEER_SELECTION_MODE=enforce
FEDERATION_MAX_BODY_BYTES=1048576
PEER_DISCOVERY_URLS=
# Comma-separated independent D1/D2/D3 origins. Keep route resolution in
# report until endpoint-signed records are published to a quorum.
ROUTE_RESOLUTION_MODE=enforce
ROUTE_DISCOVERY_URLS=
ROUTE_MINIMUM_DISCOVERY_SOURCES=2
FEDERATION_DISCOVERY_URLS=
FEDERATION_MINIMUM_DISCOVERY_SOURCES=2
MIX_DISCOVERY_URLS=
MIX_MINIMUM_DISCOVERY_SOURCES=2
MIX_PEER_CACHE_TTL_SECONDS=60
MIX_PEER_CACHE_MAX_RECORDS=1000
PEER_AUTHORITY_STATE_PATH=
PEER_DISCOVERY_SOURCE_SET_PATH=
PEER_SELECTION_REFRESH_SECONDS=60
PEER_SELECTION_ROTATION_SECONDS=3600
RELAY_WS_MAX_CONNECTIONS=100
RELAY_WS_MAX_CONNECTIONS_PER_PEER=4
RELAY_WS_MAX_CELLS_PER_BATCH=32
RELAY_WS_IDLE_TIMEOUT_SECONDS=60
RELAY_WS_CELL_TIMEOUT_SECONDS=20
RELAY_WS_SEND_TIMEOUT_SECONDS=10
RELAY_WS_MAX_FRAME_BYTES=1048576
RELAY_LINK_SEQUENCE_TTL_SECONDS=86400
RELAY_LINK_SEQUENCE_MAX_RECORDS=100000
STORAGE_MAX_OPAQUE_BYTES=2147483648
STORAGE_MAX_PADDED_POLL_BYTES=1048576
TURN_REALM=messenger.local
TURN_SERVER_TLS_PORT=5349
TURN_ENABLE_UDP=true
TURN_ENABLE_TCP=true
TURN_ENABLE_TLS=false
TURN_CREDENTIAL_TTL_SECONDS=600
