# Скопируйте в storage.secrets.env (не коммитить) и заполните.
# Используется с: ./scripts/apply-storage-profile.sh <profile>

# Общие поля (большинство провайдеров)
S3_BUCKET=messenger-your-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# AWS / Backblaze — регион из панели провайдера
S3_REGION=eu-central-1

# MinIO / Timeweb / кастомный endpoint
# S3_ENDPOINT=https://minio.example.com:9000

# Cloudflare R2 — Account ID из дашборда R2
# R2_ACCOUNT_ID=your-account-id
