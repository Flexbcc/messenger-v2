DISCOVERY_ADMIN_SECRET=REPLACE_WITH_RANDOM_32_BYTES
MESH_NOTIFY_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_32_BYTES
JWT_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_32_BYTES
GATEWAY_INVITE_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_32_BYTES
TURN_SHARED_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_32_BYTES
